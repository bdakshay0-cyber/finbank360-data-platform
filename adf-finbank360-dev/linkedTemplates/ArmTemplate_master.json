{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-finbank360-dev"
		},
		"LS_ADLS_FinBank_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stfinbank360dev.dfs.core.windows.net/"
		},
		"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-finbank360-dev.vault.azure.net/"
		},
		"LS_AzureSQL_FinBank_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-finbank360-dev.database.windows.net"
		},
		"LS_AzureSQL_FinBank_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-finbank360"
		},
		"LS_AzureSQL_FinBank_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"LS_REST_FX_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.frankfurter.dev/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-finbank360-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_FinBank_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_FinBank_properties_typeProperties_url')]"
					},
					"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"LS_REST_FX_properties_typeProperties_url": {
						"value": "[parameters('LS_REST_FX_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_FinBank_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_FinBank_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_FinBank_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_FinBank_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_FinBank_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_FinBank_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}