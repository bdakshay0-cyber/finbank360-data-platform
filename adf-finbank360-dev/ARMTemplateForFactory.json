{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-finbank360-dev"
		},
		"LS_ADLS_FinBank_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stfinbank360dev.dfs.core.windows.net/"
		},
		"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-finbank360-dev.vault.azure.net/"
		},
		"LS_AzureSQL_FinBank_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-finbank360-dev.database.windows.net"
		},
		"LS_AzureSQL_FinBank_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-finbank360"
		},
		"LS_AzureSQL_FinBank_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"LS_REST_FX_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.frankfurter.dev/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_Master_Finance_Ingestion')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LK_IngestionConfig",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT\n    ConfigId,\n    SourceName,\n    SourceType,\n    SourceObject,\n    TargetPath,\n    LoadType,\n    WatermarkColumn,\n    LastWatermark,\n    IsActive\nFROM dbo.IngestionConfig\nWHERE IsActive = 1\nORDER BY ConfigId;",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_SQL_IngestionConfig",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "FE_IngestionSources",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "LK_IngestionConfig",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('LK_IngestionConfig').output.value",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "SW_SourceType",
									"type": "Switch",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"on": {
											"value": "@item().SourceType",
											"type": "Expression"
										},
										"cases": [
											{
												"value": "SQL",
												"activities": [
													{
														"name": "Copy data",
														"type": "Copy",
														"dependsOn": [],
														"policy": {
															"timeout": "0.12:00:00",
															"retry": 0,
															"retryIntervalInSeconds": 30,
															"secureOutput": false,
															"secureInput": false
														},
														"userProperties": [],
														"typeProperties": {
															"source": {
																"type": "AzureSqlSource",
																"queryTimeout": "02:00:00",
																"partitionOption": "None"
															},
															"sink": {
																"type": "ParquetSink",
																"storeSettings": {
																	"type": "AzureBlobFSWriteSettings"
																},
																"formatSettings": {
																	"type": "ParquetWriteSettings"
																}
															},
															"enableStaging": false,
															"translator": {
																"type": "TabularTranslator",
																"typeConversion": true,
																"typeConversionSettings": {
																	"allowDataTruncation": true,
																	"treatBooleanAsNumber": false
																}
															}
														},
														"inputs": [
															{
																"referenceName": "DS_SQL_Generic",
																"type": "DatasetReference",
																"parameters": {
																	"p_SchemaName": {
																		"value": "@split(item().SourceObject,'.')[0]",
																		"type": "Expression"
																	},
																	"p_TableName": {
																		"value": "@split(item().SourceObject,'.')[1]",
																		"type": "Expression"
																	}
																}
															}
														],
														"outputs": [
															{
																"referenceName": "DS_ADLS_SQL_Landing",
																"type": "DatasetReference",
																"parameters": {
																	"p_TargetPath": {
																		"value": "@item().TargetPath",
																		"type": "Expression"
																	},
																	"p_FileName": {
																		"value": "@concat(\n    toLower(item().SourceName),\n    '_',\n    formatDateTime(utcNow(),'yyyyMMdd_HHmmss'),\n    '.parquet'\n)",
																		"type": "Expression"
																	}
																}
															}
														]
													}
												]
											},
											{
												"value": "CSV",
												"activities": [
													{
														"name": "EP_Process_CSV_Source",
														"type": "ExecutePipeline",
														"dependsOn": [],
														"policy": {
															"secureInput": false
														},
														"userProperties": [],
														"typeProperties": {
															"pipeline": {
																"referenceName": "PL_Process_CSV_Source",
																"type": "PipelineReference"
															},
															"waitOnCompletion": true,
															"parameters": {
																"p_TargetPath": {
																	"value": "@item().TargetPath",
																	"type": "Expression"
																},
																"p_SourceObject": {
																	"value": "@item().SourceObject",
																	"type": "Expression"
																},
																"p_LoadType": {
																	"value": "@item().LoadType",
																	"type": "Expression"
																},
																"p_SourceName": {
																	"value": "@item().SourceName",
																	"type": "Expression"
																}
															}
														}
													}
												]
											},
											{
												"value": "REST",
												"activities": [
													{
														"name": "WAIT_REST_NotImplemented",
														"type": "Wait",
														"dependsOn": [],
														"userProperties": [],
														"typeProperties": {
															"waitTimeInSeconds": 1
														}
													}
												]
											}
										]
									}
								}
							]
						}
					},
					{
						"name": "DBX_Run_Bronze_Job",
						"type": "DatabricksJob",
						"dependsOn": [
							{
								"activity": "FE_IngestionSources",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"jobId": "310810490554715"
						},
						"linkedServiceName": {
							"referenceName": "LS_AzureDatabricks",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_SQL_IngestionConfig')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureDatabricks')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_Generic')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_SQL_Landing')]",
				"[concat(variables('factoryId'), '/pipelines/PL_Process_CSV_Source')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Process_CSV_Source')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "SW_SourceName",
						"type": "Switch",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"on": {
								"value": "@pipeline().parameters.p_SourceName",
								"type": "Expression"
							},
							"cases": [
								{
									"value": "Transactions",
									"activities": [
										{
											"name": "EP_Process_Transactions",
											"type": "ExecutePipeline",
											"dependsOn": [],
											"policy": {
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"pipeline": {
													"referenceName": "PL_Process_Transactions",
													"type": "PipelineReference"
												},
												"waitOnCompletion": true,
												"parameters": {
													"p_TargetPath": {
														"value": "@pipeline().parameters.p_TargetPath",
														"type": "Expression"
													},
													"p_SourceName": {
														"value": "@pipeline().parameters.p_SourceName",
														"type": "Expression"
													}
												}
											}
										}
									]
								},
								{
									"value": "Merchants",
									"activities": [
										{
											"name": "EP_Process_Merchants",
											"type": "ExecutePipeline",
											"dependsOn": [],
											"policy": {
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"pipeline": {
													"referenceName": "PL_Process_Merchants",
													"type": "PipelineReference"
												},
												"waitOnCompletion": true,
												"parameters": {
													"p_TargetPath": {
														"value": "@pipeline().parameters.p_TargetPath",
														"type": "Expression"
													},
													"p_SourceObject": {
														"value": "@pipeline().parameters.p_SourceObject",
														"type": "Expression"
													},
													"p_LoadType": {
														"value": "@pipeline().parameters.p_LoadType",
														"type": "Expression"
													},
													"p_SourceName": {
														"value": "@pipeline().parameters.p_SourceName",
														"type": "Expression"
													}
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_TargetPath": {
						"type": "string"
					},
					"p_SourceObject": {
						"type": "string"
					},
					"p_LoadType": {
						"type": "string"
					},
					"p_SourceName": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/PL_Process_Transactions')]",
				"[concat(variables('factoryId'), '/pipelines/PL_Process_Merchants')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Process_Merchants')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "GM_ValidateMerchantFile",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "DS_CSV_Generic",
								"type": "DatasetReference",
								"parameters": {
									"p_FolderPath": {
										"value": "@pipeline().parameters.p_TargetPath",
										"type": "Expression"
									},
									"p_FileName": {
										"value": "@pipeline().parameters.p_SourceObject",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"exists",
								"size"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "IF_ValidMerchantFile",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "GM_ValidateMerchantFile",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@and(\n    activity('GM_ValidateMerchantFile').output.exists,\n    greater(activity('GM_ValidateMerchantFile').output.size, 0)\n)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "AUD_Merchant_Success",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL_FinBank",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "NonQuery",
												"text": {
													"value": "@concat(\n'INSERT INTO dbo.PipelineAudit\n(PipelineName, PipelineRunId, SourceSystem, SourceFile, PipelineStatus, StartTime, EndTime)\nVALUES\n(''PL_Process_Merchants'',\n''', pipeline().RunId, ''',\n''', pipeline().parameters.p_SourceName, ''',\n''', pipeline().parameters.p_SourceObject, ''',\n''SUCCESS'',\nSYSUTCDATETIME(),\nSYSUTCDATETIME());'\n)",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_TargetPath": {
						"type": "string"
					},
					"p_SourceObject": {
						"type": "string"
					},
					"p_LoadType": {
						"type": "string"
					},
					"p_SourceName": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_CSV_Generic')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSQL_FinBank')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Process_Transaction_File')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "GM_ValidateTransactionFile",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "DS_CSV_Generic",
								"type": "DatasetReference",
								"parameters": {
									"p_FolderPath": {
										"value": "@pipeline().parameters.p_TargetPath",
										"type": "Expression"
									},
									"p_FileName": {
										"value": "@pipeline().parameters.p_FileName",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"exists",
								"size"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "DelimitedTextReadSettings"
							}
						}
					},
					{
						"name": "SW_TransactionFileAction",
						"type": "Switch",
						"dependsOn": [
							{
								"activity": "GM_ValidateTransactionFile",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"on": {
								"value": "@if(\n    and(\n        activity('GM_ValidateTransactionFile').output.exists,\n        greater(activity('GM_ValidateTransactionFile').output.size, 0)\n    ),\n    if(\n        greater(pipeline().parameters.p_ProcessedCount, 0),\n        'SKIP',\n        'PROCESS'\n    ),\n    'INVALID'\n)",
								"type": "Expression"
							},
							"cases": [
								{
									"value": "PROCESS",
									"activities": [
										{
											"name": "AUD_Transaction_Success",
											"type": "Script",
											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 0,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"linkedServiceName": {
												"referenceName": "LS_AzureSQL_FinBank",
												"type": "LinkedServiceReference"
											},
											"typeProperties": {
												"scripts": [
													{
														"type": "NonQuery",
														"text": {
															"value": "@concat(\n'INSERT INTO dbo.PipelineAudit\n(PipelineName, PipelineRunId, SourceSystem, SourceFile, PipelineStatus, StartTime, EndTime)\nVALUES\n(''PL_Process_Transaction_File'',\n''', pipeline().RunId, ''',\n''', pipeline().parameters.p_SourceName, ''',\n''', pipeline().parameters.p_FileName, ''',\n''SUCCESS'',\nSYSUTCDATETIME(),\nSYSUTCDATETIME());'\n)",
															"type": "Expression"
														}
													}
												],
												"scriptBlockExecutionTimeout": "02:00:00"
											}
										}
									]
								},
								{
									"value": "SKIP",
									"activities": [
										{
											"name": "WAIT_AlreadyProcessed",
											"type": "Wait",
											"dependsOn": [],
											"userProperties": [],
											"typeProperties": {
												"waitTimeInSeconds": 1
											}
										}
									]
								},
								{
									"value": "INVALID",
									"activities": [
										{
											"name": "AUD_Transaction_Failure",
											"type": "Script",
											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 0,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"linkedServiceName": {
												"referenceName": "LS_AzureSQL_FinBank",
												"type": "LinkedServiceReference"
											},
											"typeProperties": {
												"scripts": [
													{
														"type": "NonQuery",
														"text": {
															"value": "@concat(\n'INSERT INTO dbo.PipelineAudit\n(PipelineName, PipelineRunId, SourceSystem, SourceFile, PipelineStatus, StartTime, EndTime, ErrorMessage)\nVALUES\n(''PL_Process_Transaction_File'',\n''', pipeline().RunId, ''',\n''', pipeline().parameters.p_SourceName, ''',\n''', pipeline().parameters.p_FileName, ''',\n''FAILED'',\nSYSUTCDATETIME(),\nSYSUTCDATETIME(),\n''Transaction file does not exist or is empty.'');'\n)",
															"type": "Expression"
														}
													}
												],
												"scriptBlockExecutionTimeout": "02:00:00"
											}
										},
										{
											"name": "FAIL_TransactionFile",
											"type": "Fail",
											"dependsOn": [
												{
													"activity": "AUD_Transaction_Failure",
													"dependencyConditions": [
														"Succeeded"
													]
												}
											],
											"userProperties": [],
											"typeProperties": {
												"message": {
													"value": "@concat(\n    'Transaction file validation failed: ',\n    pipeline().parameters.p_FileName,\n    '. File does not exist or is empty.'\n)",
													"type": "Expression"
												},
												"errorCode": {
													"value": "FINBANK360_INVALID_TRANSACTION_FILE",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_FileName": {
						"type": "string"
					},
					"p_TargetPath": {
						"type": "string"
					},
					"p_SourceName": {
						"type": "string"
					},
					"p_ProcessedCount": {
						"type": "int",
						"defaultValue": 0
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_CSV_Generic')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSQL_FinBank')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Process_Transactions')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "GM_TransactionFiles",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "DS_ADLS_CSV_Folder",
								"type": "DatasetReference",
								"parameters": {
									"p_FolderPath": {
										"value": "@pipeline().parameters.p_TargetPath",
										"type": "Expression"
									}
								}
							},
							"fieldList": [
								"childItems"
							],
