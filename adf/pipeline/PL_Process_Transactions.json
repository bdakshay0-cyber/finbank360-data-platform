{
	"name": "PL_Process_Transactions",
	"properties": {
		"activities": [
			{
				"name": "GM_TransactionFiles",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_ADLS_CSV_Folder",
						"type": "DatasetReference",
						"parameters": {
							"p_FolderPath": {
								"value": "@pipeline().parameters.p_TargetPath",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "BinaryReadSettings"
					}
				}
			},
			{
				"name": "FE_TransactionFiles",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GM_TransactionFiles",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GM_TransactionFiles').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "IF_ValidTransactionFile",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@and(\n    equals(item().type,'File'),\n    and(\n        startsWith(item().name,'transactions_'),\n        endsWith(item().name,'.csv')\n    )\n)",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "LK_CheckTransactionFile",
										"type": "Lookup",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "@concat(\n'SELECT COUNT(*) AS ProcessedCount\nFROM dbo.PipelineAudit\nWHERE SourceFile = ''',\nitem().name,\n'''\nAND PipelineStatus = ''SUCCESS'';'\n)",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"dataset": {
												"referenceName": "DS_SQL_IngestionConfig",
												"type": "DatasetReference"
											}
										}
									},
									{
										"name": "EP_Process_Transaction_File",
										"type": "ExecutePipeline",
										"dependsOn": [
											{
												"activity": "LK_CheckTransactionFile",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"pipeline": {
												"referenceName": "PL_Process_Transaction_File",
												"type": "PipelineReference"
											},
											"waitOnCompletion": true,
											"parameters": {
												"p_FileName": {
													"value": "@item().name",
													"type": "Expression"
												},
												"p_TargetPath": {
													"value": "@pipeline().parameters.p_TargetPath",
													"type": "Expression"
												},
												"p_SourceName": {
													"value": "@pipeline().parameters.p_SourceName",
													"type": "Expression"
												},
												"p_ProcessedCount": {
													"value": "@int(activity('LK_CheckTransactionFile').output.firstRow.ProcessedCount)",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_TargetPath": {
				"type": "string"
			},
			"p_SourceName": {
				"type": "string"
			}
		},
		"annotations": []
	}
}